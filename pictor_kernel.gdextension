[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"

[libraries]
linux.debug.x86_64 = "res://kernel_test/bin/libpictor_kernel.so"
linux.release.x86_64 = "res://kernel_test/bin/libpictor_kernel.so"
windows.debug.x86_64 = "res://kernel_test/bin/pictor_kernel.dll"
windows.release.x86_64 = "res://kernel_test/bin/pictor_kernel.dll"
